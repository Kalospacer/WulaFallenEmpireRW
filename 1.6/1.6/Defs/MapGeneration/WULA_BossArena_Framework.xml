<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Site layout framework public definitions. Layout data is declared by SitePartDef XML. -->

  <!-- Uses the original Site world object behavior with a dedicated map generator. -->
  <WorldObjectDef ParentName="Site">
    <defName>WULA_BossArenaSite</defName>
    <label>预设场地</label>
    <mapGenerator>WULA_BossArena</mapGenerator>
  </WorldObjectDef>

  <!-- Dedicated map generator for deterministic prefab-first layouts. -->
  <MapGeneratorDef>
    <defName>WULA_BossArena</defName>
    <label>WULA boss arena</label>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Terrain</li>
      <li>SiteLayoutFramework_SiteLayout</li>
      <li>FindPlayerStartSpot</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- Layout generation runs after terrain and before player start selection. -->
  <GenStepDef>
    <defName>SiteLayoutFramework_SiteLayout</defName>
    <order>800</order>
    <genStep Class="WulaFallenEmpire.GenStep_SiteLayout" />
  </GenStepDef>
</Defs>
